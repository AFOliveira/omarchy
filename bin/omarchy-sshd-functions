#!/bin/bash

# omarchy:hidden=true
# omarchy:summary=Provide shared SSH authorization helpers for setup and migration

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  echo "omarchy-sshd-functions is an internal function library." >&2
  exit 64
fi

# Key types sshd accepts as ordinary authorized keys. DSA is gone from current
# OpenSSH, and certificate types only authenticate through cert-authority.
omarchy_sshd_is_key_type() {
  case "$1" in
    ssh-ed25519 | ssh-rsa | ecdsa-sha2-nistp256 | ecdsa-sha2-nistp384 | ecdsa-sha2-nistp521 | \
      sk-ssh-ed25519@openssh.com | sk-ecdsa-sha2-nistp256@openssh.com | \
      ssh-mldsa44-ed25519@openssh.com) return 0 ;;
  esac
  return 1
}

# ssh-keygen -lf ignores the options field, so it accepts lines that sshd will
# refuse or turn into something other than a login: cert-authority, command=,
# from=, an expired expiry-time=, restrict or no-pty. Accept a line only when it
# has no options, or only flag options that leave an interactive public-key
# login intact. Anything carrying a value or a quote is refused unparsed.
omarchy_sshd_key_line_permits_login() {
  local line=$1 first option
  local -a options

  line=${line#"${line%%[![:space:]]*}"}
  first=${line%%[[:space:]]*}
  omarchy_sshd_is_key_type "$first" && return 0

  [[ -n $first && $first != *[\"=]* ]] || return 1
  IFS=, read -r -a options <<<"$first"
  ((${#options[@]} > 0)) || return 1
  for option in "${options[@]}"; do
    case "${option,,}" in
      no-agent-forwarding | no-port-forwarding | no-x11-forwarding | no-user-rc | \
        agent-forwarding | port-forwarding | x11-forwarding | user-rc | pty | \
        no-touch-required | verify-required) ;;
      *) return 1 ;;
    esac
  done

  line=${line#"$first"}
  line=${line#"${line%%[![:space:]]*}"}
  omarchy_sshd_is_key_type "${line%%[[:space:]]*}"
}

# Parsing a key proves nothing about whether sshd will accept it for this
# account: a later drop-in can remove its algorithm from PubkeyAcceptedAlgorithms,
# an RSA key can be shorter than RequiredRSASize, and RevokedKeys can list it.
# Check the line against an effective `sshd -T -C` dump for the account. An
# optional runner (for example the sudo command) reads a root-only KRL.
omarchy_sshd_key_line_accepted() {
  local line=$1 dump=$2 runner=${3:-} type key bits algorithms required revoked
  local -a fields

  omarchy_sshd_key_line_permits_login "$line" || return 1
  read -r -a fields <<<"$line"
  if omarchy_sshd_is_key_type "${fields[0]:-}"; then
    type=${fields[0]} key=${fields[1]:-}
  else
    type=${fields[1]:-} key=${fields[2]:-}
  fi
  [[ -n $type && $key =~ ^[A-Za-z0-9+/]+=*$ ]] || return 1
  bits=$(/usr/bin/ssh-keygen -lf /dev/stdin <<<"$type $key" 2>/dev/null) || return 1
  bits=${bits%% *}
  [[ $bits =~ ^[0-9]+$ ]] || return 1

  algorithms=$(/usr/bin/awk 'tolower($1) == "pubkeyacceptedalgorithms" { print $2; exit }' <<<"$dump")
  [[ -n $algorithms ]] || return 1
  case "$type" in
    ssh-rsa)
      [[ ,$algorithms, == *,rsa-sha2-512,* || ,$algorithms, == *,rsa-sha2-256,* || ,$algorithms, == *,ssh-rsa,* ]] || return 1
      required=$(/usr/bin/awk 'tolower($1) == "requiredrsasize" { print $2; exit }' <<<"$dump")
      [[ -z $required || $required =~ ^[0-9]+$ ]] || return 1
      (( bits >= ${required:-1024} )) || return 1
      ;;
    *) [[ ,$algorithms, == *,"$type",* ]] || return 1 ;;
  esac

  revoked=$(/usr/bin/awk 'tolower($1) == "revokedkeys" { print $2; exit }' <<<"$dump")
  if [[ -n $revoked && ${revoked,,} != none ]]; then
    $runner /usr/bin/ssh-keygen -Q -f "$revoked" /dev/stdin <<<"$type $key" >/dev/null 2>&1 || return 1
  fi
}
