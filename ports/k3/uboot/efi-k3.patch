diff --git a/lib/efi_loader/efi_disk.c b/lib/efi_loader/efi_disk.c
index 5feeb52c..89a57e74 100644
--- a/lib/efi_loader/efi_disk.c
+++ b/lib/efi_loader/efi_disk.c
@@ -12,6 +12,7 @@
 #include <dm.h>
 #include <dm/device-internal.h>
 #include <dm/tag.h>
+#include <dm/uclass-internal.h>
 #include <event.h>
 #include <efi_loader.h>
 #include <fs.h>
@@ -771,9 +772,18 @@ efi_status_t efi_disk_init(void)
 efi_status_t efi_disks_register(void)
 {
 	struct udevice *dev;
+	int ret;
 
-	uclass_foreach_dev_probe(UCLASS_BLK, dev) {
-	}
+	/*
+	 * Probe each block device on its own and ignore the ones that fail.
+	 * uclass_foreach_dev_probe() stops at the first probe error, and on a
+	 * board whose SD slot is empty that error is -ENOMEDIUM from an
+	 * ordinary, healthy driver. Letting it out of this loop makes entering
+	 * EFI fault before any image has been looked at.
+	 */
+	for (ret = uclass_find_first_device(UCLASS_BLK, &dev); !ret && dev;
+	     ret = uclass_find_next_device(&dev))
+		device_probe(dev);
 
 	return EFI_SUCCESS;
 }
diff --git a/lib/efi_loader/efi_setup.c b/lib/efi_loader/efi_setup.c
index c633fcd9..7785cb75 100644
--- a/lib/efi_loader/efi_setup.c
+++ b/lib/efi_loader/efi_setup.c
@@ -9,6 +9,7 @@
 
 #include <common.h>
 #include <efi_loader.h>
+#include <env.h>
 #include <efi_variable.h>
 #include <log.h>
 
@@ -336,7 +337,16 @@ efi_status_t efi_init_obj_list(void)
 		goto out;
 #endif
 #ifdef CONFIG_NET
-	ret = efi_net_register();
+	/*
+	 * Registering EFI_SIMPLE_NETWORK_PROTOCOL probes the Ethernet device on
+	 * demand, and on the K3 that walk of the MDIO registry faults in
+	 * miiphy_get_dev_by_name() (strcmp on a stale entry). Boot loaders
+	 * started from here do not use EFI networking, so it is opt-in.
+	 */
+	if (env_get("efi_net"))
+		ret = efi_net_register();
+	else
+		ret = EFI_SUCCESS;
 	if (ret != EFI_SUCCESS)
 		goto out;
 #endif
