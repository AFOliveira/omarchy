From 43d1b47619509d0261c66fae00c69419369acade Mon Sep 17 00:00:00 2001
From: Afonso Oliveira <afonso.oliveira707@gmail.com>
Date: Fri, 18 Sep 2026 01:28:30 +0800
Subject: [PATCH 2/3] efi_loader: keep registering block devices after a probe
 failure

efi_disks_register() uses uclass_foreach_dev_probe(), which stops at the
first device whose probe fails. On boards with an empty SD slot the MMC
block device fails with -ENOMEDIUM and every block device after it, here
the UFS disk holding the EFI system partition, is never registered, so a
boot loader started via bootefi cannot find its own volume.

Probe each block device on its own and skip the ones that fail.
---
 lib/efi_loader/efi_disk.c | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/lib/efi_loader/efi_disk.c b/lib/efi_loader/efi_disk.c
index 5feeb52c..89a57e74 100644
--- a/lib/efi_loader/efi_disk.c
+++ b/lib/efi_loader/efi_disk.c
@@ -12,6 +12,7 @@
 #include <dm.h>
 #include <dm/device-internal.h>
 #include <dm/tag.h>
+#include <dm/uclass-internal.h>
 #include <event.h>
 #include <efi_loader.h>
 #include <fs.h>
@@ -771,9 +772,18 @@ efi_status_t efi_disk_init(void)
 efi_status_t efi_disks_register(void)
 {
 	struct udevice *dev;
+	int ret;
 
-	uclass_foreach_dev_probe(UCLASS_BLK, dev) {
-	}
+	/*
+	 * Probe each block device on its own and ignore the ones that fail.
+	 * uclass_foreach_dev_probe() stops at the first probe error, and on a
+	 * board whose SD slot is empty that error is -ENOMEDIUM from an
+	 * ordinary, healthy driver. Letting it out of this loop makes entering
+	 * EFI fault before any image has been looked at.
+	 */
+	for (ret = uclass_find_first_device(UCLASS_BLK, &dev); !ret && dev;
+	     ret = uclass_find_next_device(&dev))
+		device_probe(dev);
 
 	return EFI_SUCCESS;
 }
