build() {
  make -C "/usr/lib/modules/${_release}/build" M="$srcdir" CC=gcc HOSTCC=gcc modules
}

package() {
  local dest="$pkgdir/usr/lib/modules/${_release}/extramodules"
  install -d "$dest"
  local ko
  for ko in "$srcdir"/*.ko; do
    install -m644 "$ko" "$dest/"
  done
  zstd -q --rm "$dest"/*.ko
}
