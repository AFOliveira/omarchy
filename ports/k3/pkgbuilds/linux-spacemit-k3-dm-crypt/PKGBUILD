# dm-crypt for the SpacemiT K3 vendor kernel, which is built without
# CONFIG_DM_CRYPT. The sources are the kernel's own, from the stable tree at the
# vendor kernel's version, built out of tree against linux-spacemit-k3-headers:
# dm-crypt, and dm-integrity with what it needs (dm-bufio, async_tx, async_xor).
# This is what lets mkinitcpio's encrypt hook, and so a LUKS root, work here.

pkgname=linux-spacemit-k3-dm-crypt
_release=6.18.3-generic
_kver=6.18.3
pkgver=${_kver}
pkgrel=1
pkgdesc="dm-crypt and dm-integrity modules for the SpacemiT K3 vendor kernel"
arch=(riscv64)
url="https://www.kernel.org/"
license=(GPL-2.0-only)
depends=(linux-spacemit-k3)
makedepends=(linux-spacemit-k3-headers)
options=(!debug !strip)
source=("dm-crypt.c::https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/plain/drivers/md/dm-crypt.c?h=v${_kver}"
        "dm-integrity.c::https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/plain/drivers/md/dm-integrity.c?h=v${_kver}"
        "dm-bufio.c::https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/plain/drivers/md/dm-bufio.c?h=v${_kver}"
        "dm-audit.c::https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/plain/drivers/md/dm-audit.c?h=v${_kver}"
        "dm-audit.h::https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/plain/drivers/md/dm-audit.h?h=v${_kver}"
        "dm-bio-record.h::https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/plain/drivers/md/dm-bio-record.h?h=v${_kver}"
        "dm-core.h::https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/plain/drivers/md/dm-core.h?h=v${_kver}"
        "dm.h::https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/plain/drivers/md/dm.h?h=v${_kver}"
        "dm-stats.h::https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/plain/drivers/md/dm-stats.h?h=v${_kver}"
        "dm-ima.h::https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/plain/drivers/md/dm-ima.h?h=v${_kver}"
        "async_tx.c::https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/plain/crypto/async_tx/async_tx.c?h=v${_kver}"
        "async_xor.c::https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/plain/crypto/async_tx/async_xor.c?h=v${_kver}"
        Kbuild)
sha256sums=('21288cb9b01bcbd537a6f562fb6e547fd071938add2bac2619e831e9fb9f482f'
