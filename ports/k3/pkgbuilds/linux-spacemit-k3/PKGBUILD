# SpacemiT's kernel for the K3, repackaged from Bianbu's linux-image deb into the
# layout Arch's own kernel packages use (/usr/lib/modules/<release>/{vmlinuz,pkgbase}),
# so mkinitcpio, limine-entry-tool and the pacman hooks treat it like any kernel.
# Nothing is rebuilt: the deb is the vendor's binary build, checksummed.

pkgname=linux-spacemit-k3
_release=6.18.3-generic
_debver=6.18.3-1.0.0.4
pkgver=${_debver//-/.}
pkgrel=1
pkgdesc="SpacemiT vendor kernel for the K3 (Bianbu linux-image-${_release} ${_debver})"
arch=(riscv64)
url="https://archive.spacemit.com/bianbu4/"
license=(GPL-2.0-only)
depends=(coreutils kmod initramfs)
options=(!debug !strip)
install=linux-spacemit-k3.install
_deb="linux-image-${_release}_${_debver}_riscv64.deb"
source=("${_deb}::${url}pool/main/l/linux-riscv-spacemit-generic/${_deb}")
sha512sums=('deb8792dcb21ef9dd0ea9a680c1eb8084c6386386d6eb409edfbd7eab55097d59b588c7f4e5b24c17f0f4798263f35d256b904a59fdeccfb4d6ddb70ae864f0c')
noextract=("${_deb}")

prepare() {
  rm -rf deb && mkdir deb && cd deb
  bsdtar -xf "$srcdir/${_deb}" data.tar.zst
  bsdtar -xf data.tar.zst
}

package() {
  local modulesdir="$pkgdir/usr/lib/modules/${_release}"
  install -d "$modulesdir"
  cp -a "$srcdir/deb/lib/modules/${_release}/." "$modulesdir/"
  # depmod's output is regenerated by the depmod pacman hook, as for Arch's kernels
  rm -f "$modulesdir"/build "$modulesdir"/source \
    "$modulesdir"/modules.{alias,alias.bin,dep,dep.bin,devname,softdep,symbols,symbols.bin,weakdep,builtin.alias.bin,builtin.bin}
  # Bianbu ships the Image gzip-wrapped as vmlinuz; the stub, Limine and U-Boot
  # want the Image itself (a RISC-V PE with an EFI stub)
  zcat "$srcdir/deb/boot/vmlinuz-${_release}" > "$modulesdir/vmlinuz"
  chmod 644 "$modulesdir/vmlinuz"
  echo "$pkgname" > "$modulesdir/pkgbase"
  install -d "$modulesdir/dtbs"
  cp -a "$srcdir/deb/usr/lib/linux-image-${_release}/." "$modulesdir/dtbs/"
}
