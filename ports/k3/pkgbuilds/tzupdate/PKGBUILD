# Maintainer: Chris Down <chris@chrisdown.name>

pkgname=tzupdate
pkgver=3.1.0
pkgrel=1.1
pkgdesc='Set the system timezone based on IP geolocation'
url=https://github.com/cdown/tzupdate
arch=('riscv64')
options=(!lto)
license=('MIT')
makedepends=('cargo')
source=("$url/archive/refs/tags/$pkgver.tar.gz"
  'riscv-tls.patch')
sha256sums=('aebf678afd261852bd3ebf4689a9a7382c3e4e43a92864b77cbee2d26ec62e22'
  'de0ca9b910e501447743b88de60717e53207be2ff479f9a3df906140d19f1e5f')

prepare() {
  patch -d "$srcdir/$pkgname-$pkgver" -p1 < "$srcdir/riscv-tls.patch"
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  cargo build --release --locked
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 target/release/tzupdate "$pkgdir/usr/bin/tzupdate"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
