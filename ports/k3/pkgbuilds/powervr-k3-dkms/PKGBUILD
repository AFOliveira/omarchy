# The mainline PowerVR driver (drivers/gpu/drm/imagination) of Linux 7.2.6,
# rebuilt with the one change the SpacemiT K3 needs and that is in review
# upstream: probing without a power domain, which the K3's boot loader leaves on
# ("drm/imagination: support GPU on SpacemiT K3", July 2026). Everything else is
# the kernel's own source; DKMS installs it over the in-tree module.
#
# The K3's GPU is a BXM-4-64 at revision 36.56.104.183, which has no mainline
# firmware yet. Mesa's device tables list it with exactly the features, quirks
# and enhancements of 36.52.104.182 (the TH1520's), so the port runs it with
# that revision's firmware through the driver's gpuid parameter.

pkgname=powervr-k3-dkms
_kver=7.2.6
pkgver=${_kver}
pkgrel=4
pkgdesc="Mainline PowerVR driver with SpacemiT K3 support (DKMS)"
arch=(any)
url="https://www.kernel.org/"
license=("GPL-2.0-only OR MIT")
depends=(dkms linux-firmware-other)
