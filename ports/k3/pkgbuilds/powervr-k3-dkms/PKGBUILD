prepare() {
  rm -rf build && mkdir build
  local f
  for f in *.c *.h; do cp -L "$f" build/; done
  patch -d build -p1 < 0001-drm-imagination-allow-probe-when-no-power-domains-are-described.patch
  # Out of tree, the trace header is found next to the sources (-I$(src) in the
  # Makefile), not at its in-tree path relative to include/trace/.
  sed -i 's|^#define TRACE_INCLUDE_PATH .*|#define TRACE_INCLUDE_PATH .|' build/pvr_trace.h
}

package() {
  local dest="$pkgdir/usr/src/powervr-k3-$pkgver"
  install -d "$dest"
  install -m644 build/*.c build/*.h Makefile "$dest/"
  sed "s/@PKGVER@/$pkgver/" dkms.conf > "$dest/dkms.conf"
  # Run the K3's GPU (36.56.104.183) with the firmware of 36.52.104.182, which
  # Mesa describes identically; only mainline kernels load this module.
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/modprobe.d/powervr-k3.conf" <<'EOF'
options powervr gpuid=36.52.104.182 exp_hw_support=1
EOF
}
