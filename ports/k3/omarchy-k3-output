#!/bin/bash
set -euo pipefail

# A separate output keeps cloud rendering independent of an attached display.
# The allocator comes from DRM on the Arch host, or Wayland in the container.
if ! hyprctl monitors all -j | jq -e '.[] | select(.name == "K3-CLOUD")' >/dev/null; then
  hyprctl output create headless K3-CLOUD
fi
hyprctl keyword monitor "K3-CLOUD,1920x1080@60,0x0,1"
# The cloud viewer shows only K3-CLOUD; turn off whatever else the DRM device
# exposes (SpacemiT's display connector, or the virtual connector of vkms).
hyprctl monitors all -j | jq -r '.[] | select(.name != "K3-CLOUD") | .name' | while read -r name; do
  hyprctl keyword monitor "$name,disable" >/dev/null
done
hyprctl dispatch focusmonitor K3-CLOUD
hyprctl dispatch workspace 1
