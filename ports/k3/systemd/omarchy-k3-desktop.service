[Unit]
Description=Omarchy K3 desktop through UWSM
After=user@1000.service
Wants=user@1000.service

[Service]
Type=exec
User=afonso
PAMName=login
Environment=XDG_SEAT=seat0
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_DESKTOP=Hyprland
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
WorkingDirectory=/home/afonso
ExecStart=/usr/bin/uwsm start -e -D Hyprland -g -1 /usr/local/bin/omarchy-k3-session
ExecStop=/usr/bin/uwsm stop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
