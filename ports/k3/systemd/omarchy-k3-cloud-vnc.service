[Unit]
Description=Forward the assigned BianbuCloud display port to Omarchy
After=network.target omarchy-k3-host-desktop.service
Wants=omarchy-k3-host-desktop.service

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:5901,bind=0.0.0.0,reuseaddr,fork TCP:127.0.0.1:5900
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
